{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/occurrence.schema.json",
  "title": "Occurrence (API v1)",
  "description": "One dated instance of an event, as served by /api/v1/occurrences. Two rules are checked outside JSON Schema, by tests/conformance.py: end must not be before start, and a local date-time's offset must be the one in force in Europe/Paris at that instant (e.g. +02:00 in November is wrong). A Z offset is already rejected by the localDateTime pattern.",
  "type": "object",
  "required": [
    "id",
    "url",
    "event_id",
    "name",
    "start",
    "timezone",
    "status",
    "category",
    "location",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "start": {
      "$ref": "#/$defs/localDateOrDateTime"
    },
    "end": {
      "anyOf": [
        {
          "$ref": "#/$defs/localDateOrDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "timezone": {
      "const": "Europe/Paris"
    },
    "status": {
      "enum": [
        "scheduled",
        "rescheduled",
        "postponed",
        "cancelled"
      ]
    },
    "previous_start": {
      "anyOf": [
        {
          "$ref": "#/$defs/localDateOrDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "location": {
      "type": "object",
      "required": [
        "name",
        "street",
        "postal_code",
        "commune",
        "commune_name",
        "lat",
        "lon"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "street": {
          "type": [
            "string",
            "null"
          ]
        },
        "postal_code": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "commune": {
          "type": "string",
          "pattern": "^[0-9][0-9AB][0-9]{3}$"
        },
        "commune_name": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "organizer": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "offers": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "is_free",
            "price",
            "url"
          ],
          "properties": {
            "is_free": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "price": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "licence",
          "updated_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "updated_at": {
            "$ref": "#/$defs/localDateTime"
          }
        }
      }
    },
    "updated_at": {
      "$ref": "#/$defs/localDateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "rescheduled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "previous_start"
        ],
        "properties": {
          "previous_start": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "localDateTime": {
      "description": "RFC 3339 with the Europe/Paris offset (+01:00 or +02:00); never Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+0[12]:00$",
      "format": "date-time"
    },
    "localDateOrDateTime": {
      "anyOf": [
        {
          "$ref": "#/$defs/localDate"
        },
        {
          "$ref": "#/$defs/localDateTime"
        }
      ]
    }
  }
}
