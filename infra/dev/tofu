#!/usr/bin/env bash
# OpenTofu on infra/dev/ (the dev VM's project), like ../tofu for prod. Through run-scw only:
#   tools/dev run-scw 'nix develop -c infra/dev/tofu plan'
# SCW_DEFAULT_PROJECT_ID (prod's project) is unset: every resource here names its project.
set -euo pipefail
: "${SCW_ACCESS_KEY:?run through tools/dev run-scw}" "${SCW_SECRET_KEY:?}" "${SCW_DEFAULT_ORGANIZATION_ID:?}"
export AWS_ACCESS_KEY_ID=$SCW_ACCESS_KEY AWS_SECRET_ACCESS_KEY=$SCW_SECRET_KEY
unset SCW_DEFAULT_PROJECT_ID
export TF_IN_AUTOMATION=1
exec tofu -chdir="$(dirname "$0")" "$@"
