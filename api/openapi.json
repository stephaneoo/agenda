{
  "components": {
    "schemas": {
      "Category": {
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "label"
        ],
        "title": "Category",
        "type": "object"
      },
      "Commune": {
        "properties": {
          "insee": {
            "title": "Insee",
            "type": "string"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "insee",
          "name",
          "lat",
          "lon"
        ],
        "title": "Commune",
        "type": "object"
      },
      "Event": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "occurrences": {
            "description": "Published occurrences from today onwards",
            "items": {
              "$ref": "#/components/schemas/Occurrence"
            },
            "title": "Occurrences",
            "type": "array"
          },
          "offers": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Offers"
              },
              {
                "type": "null"
              }
            ]
          },
          "organizer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Organizer"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "title": "Sources",
            "type": "array"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "location",
          "organizer",
          "offers",
          "sources",
          "updated_at",
          "occurrences"
        ],
        "title": "Event",
        "type": "object"
      },
      "Location": {
        "properties": {
          "commune": {
            "description": "INSEE code",
            "title": "Commune",
            "type": "string"
          },
          "commune_name": {
            "title": "Commune Name",
            "type": "string"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "postal_code": {
            "title": "Postal Code",
            "type": "string"
          },
          "street": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street"
          }
        },
        "required": [
          "name",
          "street",
          "postal_code",
          "commune",
          "commune_name",
          "lat",
          "lon"
        ],
        "title": "Location",
        "type": "object"
      },
      "Occurrence": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Same format as start; null means no end to display",
            "title": "End"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "offers": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Offers"
              },
              {
                "type": "null"
              }
            ]
          },
          "organizer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Organizer"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when status is rescheduled",
            "title": "Previous Start"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "title": "Sources",
            "type": "array"
          },
          "start": {
            "description": "Local date-time (RFC 3339, Europe/Paris offset), or a local date YYYY-MM-DD",
            "title": "Start",
            "type": "string"
          },
          "status": {
            "description": "scheduled | rescheduled | postponed | cancelled",
            "title": "Status",
            "type": "string"
          },
          "timezone": {
            "description": "Always \"Europe/Paris\"",
            "title": "Timezone",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          },
          "url": {
            "description": "Absolute URL of the public page",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "event_id",
          "name",
          "description",
          "start",
          "end",
          "timezone",
          "status",
          "previous_start",
          "category",
          "location",
          "organizer",
          "offers",
          "sources",
          "updated_at"
        ],
        "title": "Occurrence",
        "type": "object"
      },
      "OccurrencePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Occurrence"
            },
            "title": "Items",
            "type": "array"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque cursor of the next page; null on the last page",
            "title": "Next"
          }
        },
        "required": [
          "items",
          "next"
        ],
        "title": "OccurrencePage",
        "type": "object"
      },
      "Offers": {
        "properties": {
          "is_free": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Free"
          },
          "price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "is_free",
          "price",
          "url"
        ],
        "title": "Offers",
        "type": "object"
      },
      "Organizer": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "title": "Organizer",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details, served as application/problem+json.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "SourceRef": {
        "properties": {
          "licence": {
            "title": "Licence",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "description": "The source's last update of this record, local date-time",
            "title": "Updated At",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "name",
          "url",
          "licence",
          "updated_at"
        ],
        "title": "SourceRef",
        "type": "object"
      },
      "SourceStatus": {
        "properties": {
          "last_success": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "last_success"
        ],
        "title": "SourceStatus",
        "type": "object"
      },
      "Status": {
        "properties": {
          "last_sync": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "last_sync",
          "sources"
        ],
        "title": "Status",
        "type": "object"
      },
      "TravelTimes": {
        "properties": {
          "communes": {
            "items": {
              "type": "string"
            },
            "title": "Communes",
            "type": "array"
          },
          "minutes": {
            "description": "minutes[i][j]: from communes[i] to communes[j]; null: unreachable",
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "title": "Minutes",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "communes",
          "minutes"
        ],
        "title": "TravelTimes",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only API of the events agenda around Nyons. Data: Licence Ouverte 2.0; each occurrence cites its sources and their last update date.",
    "title": "Agenda — API publique",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/categories": {
      "get": {
        "operationId": "api_v1_categories",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Category slugs and labels"
      }
    },
    "/api/v1/communes": {
      "get": {
        "operationId": "api_v1_communes",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Commune"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Covered communes"
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "operationId": "api_v1_event",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "One event, with its coming occurrences"
      }
    },
    "/api/v1/occurrences": {
      "get": {
        "operationId": "api_v1_occurrences",
        "parameters": [
          {
            "description": "INSEE code of the origin; required with within",
            "in": "query",
            "name": "commune",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "INSEE code of the origin; required with within",
              "title": "Commune"
            }
          },
          {
            "description": "Minutes by car from commune, 0 to 60",
            "in": "query",
            "name": "within",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minutes by car from commune, 0 to 60",
              "title": "Within"
            }
          },
          {
            "description": "Local date, inclusive; default today",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local date, inclusive; default today",
              "title": "From"
            }
          },
          {
            "description": "Local date, inclusive; default from + 30 days",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local date, inclusive; default from + 30 days",
              "title": "To"
            }
          },
          {
            "description": "Category slugs, repeated",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "default": [],
              "description": "Category slugs, repeated",
              "items": {
                "type": "string"
              },
              "title": "Category",
              "type": "array"
            }
          },
          {
            "description": "The `next` of the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The `next` of the previous page",
              "title": "Cursor"
            }
          },
          {
            "description": "1 to 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "1 to 200",
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrencePage"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Search occurrences"
      }
    },
    "/api/v1/occurrences/{id}": {
      "get": {
        "operationId": "api_v1_occurrence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Occurrence"
                }
              }
            },
            "description": "OK"
          },
          "301": {
            "description": "Moved Permanently"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "One occurrence"
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "api_v1_status",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Last sync of each source"
      }
    },
    "/api/v1/travel-times": {
      "get": {
        "operationId": "api_v1_travel_times",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TravelTimes"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Travel-time matrix of the covered area"
      }
    }
  },
  "servers": []
}
